# Local working material - never publish. This directory may contain raw
# source documents and extracted drafts; keep it out of any public repository.
.workbuddy/

# Downloaded third-party datasets (ODC-By 1.0 / CC BY 4.0).  Not
# redistributed here: run tools/fetch_dataset.py to obtain byte-identical,
# checksum-verified files and keep upstream attribution unambiguous.
data/

# Generated artefacts
output/
*.wav
*.png
*.json

# ...except the figures quoted in the paper: these are derived from the
# committed measurement JSON by examples/make_figures.py and are part of the
# manuscript, not of a run.
!paper/figures/*.png

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
